<!-- Botão de WhatsApp no Cabeçalho -->
<title>Botão de WhatsApp no Cabeçalho</title> <!-- Extra title tag (note: should be removed as only one title is allowed) -->
<style> <!-- Begins internal CSS for the WhatsApp button -->
    /* Estilo do botão no cabeçalho */
    .whatsapp-button { /* Styles for the WhatsApp button */
        position: fixed; /* Fixes the button position on the screen */
        top: 20px; /* Positions the button 20px from the top */
        right: 20px; /* Positions the button 20px from the right */
        background-color: #25d366; /* Sets the button background to WhatsApp green */
        color: white; /* Sets the text/icon color to white */
        border-radius: 50%; /* Makes the button circular */
        width: 60px; /* Sets the button width */
        height: 60px; /* Sets the button height */
        display: flex; /* Uses flexbox for centering content */
        align-items: center; /* Centers content vertically */
        justify-content: center; /* Centers content horizontally */
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); /* Adds a subtle shadow */
        cursor: pointer; /* Changes cursor to pointer on hover */
        z-index: 1000; /* Ensures the button appears above other elements */
        text-decoration: none; /* Removes underline from the link */
        animation: heartbeat 2.5s infinite; /* Applies a heartbeat animation */
    }

    .whatsapp-button:hover { /* Styles for the button on hover */
        background-color: #1ebc57; /* Changes background to a darker green */
    }

    .whatsapp-button img { /* Styles for the WhatsApp icon inside the button */
        width: 30px; /* Sets icon width */
        height: 30px; /* Sets icon height */
    }

    @keyframes heartbeat { /* Defines the heartbeat animation keyframes */
        0% { transform: scale(1); } /* Normal size at start */
        25% { transform: scale(1.1); } /* Slightly larger at 25% */
        50% { transform: scale(1); } /* Back to normal at 50% */
        75% { transform: scale(1.1); } /* Slightly larger at 75% */
        100% { transform: scale(1); } /* Back to normal at end */
    }
</style> <!-- Closes internal CSS -->
</head> <!-- Extra head tag (should be removed as only one head tag is allowed) -->

