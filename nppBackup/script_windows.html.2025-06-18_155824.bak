                        <div class="blog-item position-relative bg-light rounded p-4">
                            <h3>Script PowerShell para Monitoramento de Disco</h3>
                            <p class="text-muted mb-4">Este script PowerShell verifica o uso de disco em servidores Windows, exibindo alertas se o espaço livre estiver abaixo de 20%. Ele segue boas práticas com comentários e tratamento de erros.</p>
                            <pre><code class="language-powershell">
# Script para monitoramento de uso de disco em servidores Windows
# Autor: Aguiar Informática
# Data: 17/06/2025

# Função para verificar espaço em disco
function Get-DiskUsage {
    param (
        [Parameter(Mandatory=$true)]
        [string]$ComputerName = $env:COMPUTERNAME
    )

    try {
        # Obtém informações dos discos
        $disks = Get-WmiObject -Class Win32_LogicalDisk -ComputerName $ComputerName -Filter "DriveType=3" -ErrorAction Stop

        foreach ($disk in $disks) {
            $freeSpaceGB = [math]::Round($disk.FreeSpace / 1GB, 2)
            $totalSpaceGB = [math]::Round($disk.Size / 1GB, 2)
            $usedPercent = [math]::Round((($disk.Size - $disk.FreeSpace) / $disk.Size) * 100, 2)

            Write-Host "Disco: $($disk.DeviceID)"
            Write-Host "Espaço Total: $totalSpaceGB GB"
            Write-Host "Espaço Livre: $freeSpaceGB GB"
            Write-Host "Uso: $usedPercent%"

            if ($usedPercent -gt 80) {
                Write-Warning "Alerta: Disco $($disk.DeviceID) com uso acima de 80%!"
            }
        }
    }
    catch {
        Write-Error "Erro ao obter informações do disco: $_"
    }
}

# Executa a função
Get-DiskUsage
                            </code></pre>
                            <p><strong>Instruções:</strong> Salve como <code>disk_usage.ps1</code> e execute no PowerShell com privilégios administrativos usando <code>.\disk_usage.ps1</code>.</p>
