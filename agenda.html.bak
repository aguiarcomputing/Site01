		<!-- Botão de WhatsApp no Cabeçalho -->
    <title>Botão de WhatsApp no Cabeçalho</title>
    <style>
        /* Estilo do botão no cabeçalho */
        .whatsapp-button {
            position: fixed;
            top: 20px; /* Mantém o botão no topo */
            right: 20px; /* Posiciona o botão à direita */
            background-color: #25d366;
            color: white;
            border-radius: 50%;
            width: 60px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            cursor: pointer;
            z-index: 1000;
            text-decoration: none;
            animation: heartbeat 2.5s infinite;
        }

        .whatsapp-button:hover {
            background-color: #1ebc57;
        }

        .whatsapp-button img {
            width: 30px;
            height: 30px;
        }

        @keyframes heartbeat {
            0% {
                transform: scale(1);
            }
            25% {
                transform: scale(1.1);
            }
            50% {
                transform: scale(1);
            }
            75% {
                transform: scale(1.1);
            }
            100% {
                transform: scale(1);
            }
        }

    </style>
	</head>

<body>
    <!-- Botão de WhatsApp no Cabeçalho -->
    <a href="https://wa.me/5548991890567" class="whatsapp-button" target="_blank" title="WhatsApp Online">
        <img src="https://upload.wikimedia.org/wikipedia/commons/6/6b/WhatsApp.svg" alt="WhatsApp">
    </a>
    <title>Calendário 2025</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f4f4f9;
            color: #333;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
            text-align: center;
        }

        h1 {
            text-align: center;
            margin-bottom: 20px;
        }

        .calendar {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .month {
            background-color: #fff;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            border-radius: 8px;
            overflow: hidden;
            padding: 10px;
        }

        .month h2 {
            background-color: #4CAF50;
            color: white;
            margin: 0;
            padding: 10px;
            text-align: center;
        }

        .month table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        .month th, .month td {
            padding: 8px;
            text-align: center;
            border: 1px solid #ddd;
        }

        .month th {
            background-color: #f4f4f9;
        }

        .month td {
            background-color: #fff;
        }

        .month td:hover {
            background-color: #e7f7e7;
            cursor: pointer;
        }

        @media (max-width: 768px) {
            .calendar {
                grid-template-columns: repeat(1, 1fr);
            }
        }

        /* Modal styles */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            background-color: #fff;
            padding: 20px;
            border-radius: 8px;
            width: 300px;
            text-align: center;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .modal-content h3 {
            margin-top: 0;
        }

        .modal-content select, .modal-content button {
            width: 100%;
            margin-top: 10px;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
        }

        .modal-content button {
            background-color: #4CAF50;
            color: white;
            border: none;
            cursor: pointer;
        }

        .modal-content button:hover {
            background-color: #45a049;
        }

        .close {
            color: red;
            float: right;
            font-size: 20px;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Calendário 2025</h1>
        <div class="calendar">
            <!-- Janeiro -->
            <div class="month">
                <h2>Janeiro</h2>
                <table>
                    <thead>
                        <tr>
                            <th>Dom</th>
                            <th>Seg</th>
                            <th>Ter</th>
                            <th>Qua</th>
                            <th>Qui</th>
                            <th>Sex</th>
                            <th>Sáb</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td></td><td>1</td><td>2</td><td>3</td><td>4</td><td>5</td><td>6</td>
                        </tr>
                        <tr>
                            <td>7</td><td>8</td><td>9</td><td>10</td><td>11</td><td>12</td><td>13</td>
                        </tr>
                        <tr>
                            <td>14</td><td>15</td><td>16</td><td>17</td><td>18</td><td>19</td><td>20</td>
                        </tr>
                        <tr>
                            <td>21</td><td>22</td><td>23</td><td>24</td><td>25</td><td>26</td><td>27</td>
                        </tr>
                        <tr>
                            <td>28</td><td>29</td><td>30</td><td>31</td><td></td><td></td><td></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal for scheduling -->
    <div class="modal" id="scheduleModal">
        <div class="modal-content">
            <span class="close" onclick="closeModal()">&times;</span>
            <h3>Agendar Serviço</h3>
            <p id="selectedDate"></p>
            <select id="serviceType">
                <option value="">Selecione o Serviço</option>
                <option value="Consultoria">Consultoria</option>
                <option value="Reparo">Reparo</option>
                <option value="Instalação">Instalação</option>
            </select>
            <button onclick="scheduleService()">Agendar</button>
        </div>
    </div>

    <script>
        const days = document.querySelectorAll(".month td");
        const modal = document.getElementById("scheduleModal");
        const selectedDate = document.getElementById("selectedDate");

        days.forEach(day => {
            day.addEventListener("click", () => {
                if (day.textContent.trim() !== "") {
                    selectedDate.textContent = `Dia selecionado: ${day.textContent}`;
                    modal.style.display = "flex";
                }
            });
        });

        function closeModal() {
            modal.style.display = "none";
        }

        function scheduleService() {
            const service = document.getElementById("serviceType").value;
            if (service) {
                alert(`Serviço '${service}' agendado para ${selectedDate.textContent}`);
                closeModal();
            } else {
                alert("Por favor, selecione um tipo de serviço.");
            }
        }
    </script>
</body>
</html>
