<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Informações da Memória</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
        }
        #output {
            white-space: pre-wrap;
            background: #f0f0f0;
            padding: 10px;
            border-radius: 5px;
        }
    </style>
</head>
<body>
    <h2>Informações da Memória do Sistema</h2>
    <button onclick="getMemoryInfo()">Obter Informações</button>
    <pre id="output">Clique no botão para obter as informações da memória.</pre>

    <script>
        function getMemoryInfo() {
            const output = document.getElementById('output');
            output.textContent = 'Obtendo informações...';

            // Usando ActiveXObject para executar o comando (funciona apenas no Internet Explorer)
            try {
                const WShell = new ActiveXObject("WScript.Shell");
                const tempPath = WShell.ExpandEnvironmentStrings("%temp%");
                const command = `wmic memorychip get Capacity, Manufacturer, PartNumber, Speed > "${tempPath}\\memory_info.txt"`;

                WShell.Run('cmd.exe /c ' + command, 0, true);

                // Ler o arquivo gerado
                const fso = new ActiveXObject("Scripting.FileSystemObject");
                const file = fso.OpenTextFile(tempPath + "\\memory_info.txt", 1);
                const content = file.ReadAll();
                file.Close();

                output.textContent = content;
            } catch (e) {
                output.textContent = 'Erro: ' + e.message + '\nEste script requer o Internet Explorer e permissões para ActiveX.';
            }
        }
    </script>
</body>
</html>