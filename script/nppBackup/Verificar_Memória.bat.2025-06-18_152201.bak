@echo off
setlocal EnableDelayedExpansion

:: Configura cores para exibição
color 0a
cls

:: Exibe informações da empresa
echo.
echo [1;36m==================================================[0m
echo [1;36m         AGUIAR INFORMATICA - IT Solutions         [0m
echo [1;36m==================================================[0m
echo.
echo [1;33mTelefone: (48) 9 9189-0567[0m
echo [1;33mSite: https://www.aguiarinformatica.com.br/[0m
echo [1;33mE-mail: suporte@aguiarinformatica.com.br[0m
echo.
echo [1;36m--------------------------------------------------[0m
echo.

:: Cria um arquivo temporário único
set "tempfile=%temp%\memory_info_%random%.txt"

:: Executa o comando WMIC e verifica erros
echo [1;32mCOLETANDO INFORMACOES DA MEMORIA...[0m
wmic memorychip get Capacity, Manufacturer, PartNumber, Speed > "!tempfile!" || (
    echo [1;31mERRO: FALHA AO COLETAR INFORMACOES DA MEMORIA![0m
    pause
    exit /b 1
)

:: Exibe o conteúdo do arquivo temporário
echo.
echo [1;33mINFORMACOES DA MEMORIA:[0m
echo.
type "!tempfile!"
echo.

:: Pergunta ao usuário se deseja copiar o resultado
:prompt
set /p copy_choice=[1;32mDESEJA COPIAR AS INFORMACOES PARA A AREA DE TRANSFERENCIA? (S/N): [0m
if /i "!copy_choice!"=="S" (
    clip < "!tempfile!" && (
        echo [1;32mINFORMACOES COPIADAS PARA A AREA DE TRANSFERENCIA![0m
    ) || (
        echo [1;31mERRO AO COPIAR PARA A AREA DE TRANSFERENCIA![0m
    )
) else if /i "!copy_choice!"=="N" (
    echo.
) else (
    echo [1;31mENTRADA INVALIDA! POR FAVOR, DIGITE S OU N.[0m
    goto prompt
)

:: Remove o arquivo temporário
del "!tempfile!"

echo.
echo [1;36m--------------------------------------------------[0m
echo [1;36mOBRIGADO POR UTILIZAR SERVICOS DA AGUIAR INFORMATICA![0m
echo.

pause
endlocal